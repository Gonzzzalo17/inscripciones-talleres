sequenceDiagram
    title CU-02 Editar datos del taller (HU-01)
    actor C as Coordinador
    participant UI as editar_taller.html
    participant V as views.editar_taller
    participant F as TallerForm
    participant S as Servicio Coordinador
    participant T as Taller (modelo)
    participant H as Historial (modelo)
    participant DB as BD principal

    C->>UI: Selecciona un taller y elige "Editar"
    UI->>V: GET /talleres/<pk>/editar/
    V->>T: get_object_or_404(pk)
    T->>DB: SELECT taller
    DB-->>T: Datos del taller
    T-->>V: Taller
    alt E2: el taller ya empezó
        V-->>UI: "El taller ya empezó, no se puede editar"
        UI-->>C: Mensaje de error
    else El taller no ha empezado
        V-->>UI: Formulario con los datos actuales
        C->>UI: Cambia los datos y escribe el motivo
        UI->>V: POST datos + motivo
        V->>F: is_valid()
        alt E1: datos inválidos
            F-->>V: Errores de validación
            V-->>UI: Muestra el error (no se guarda nada)
            UI-->>C: Mensaje de error
        else Datos válidos
            F-->>V: Datos limpios
            V->>S: editar_taller(taller, datos, motivo)
            S->>T: save(datos nuevos)
            T->>DB: UPDATE taller
            DB-->>T: OK
            S->>H: create(taller, cambio, motivo, fecha)
            H->>DB: INSERT registro de cambio
            DB-->>H: OK
            S-->>V: Taller actualizado
            V-->>UI: redirect a lista de talleres
            UI-->>C: Datos actualizados
        end
    end
